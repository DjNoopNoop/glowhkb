<div class="list-group admin-sidebar">
  <%= link_to content_tag(:span, (content_tag(:i, '', class: 'fa-solid fa-users', style: 'display:inline-block;width:1.5rem;text-align:center;margin-right:0.5rem;') + content_tag(:span, 'Users')).html_safe, class: 'd-inline-flex align-items-center'), admin_users_path, class: ["list-group-item", "list-group-item-action", (controller_path.start_with?("admin/users") ? "active" : nil)].compact.join(" ") %>
  <%= link_to content_tag(:span, (content_tag(:i, '', class: 'fa-solid fa-user-plus', style: 'display:inline-block;width:1.5rem;text-align:center;margin-right:0.5rem;') + content_tag(:span, 'Pending Registrants')).html_safe, class: 'd-inline-flex align-items-center'), admin_registrants_path, class: ["list-group-item", "list-group-item-action", (controller_path.start_with?("admin/registrants") ? "active" : nil)].compact.join(" ") %>
  <%= link_to content_tag(:span, (content_tag(:i, '', class: 'fa-solid fa-file-lines', style: 'display:inline-block;width:1.5rem;text-align:center;margin-right:0.5rem;') + content_tag(:span, 'Publications')).html_safe, class: 'd-inline-flex align-items-center'), admin_publications_path, class: ["list-group-item", "list-group-item-action", (controller_path.start_with?("admin/publications") ? "active" : nil)].compact.join(" ") %>
</div>
