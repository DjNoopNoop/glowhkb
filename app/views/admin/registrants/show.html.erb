<div class="d-flex justify-content-between align-items-start mb-3">
  <h1>Registrant: <%= @registrant.username.presence || @registrant.email %></h1>
  <div class="actions d-flex gap-2 mt-2">
    <%= link_to 'Back', admin_registrants_path, class: 'btn btn-secondary' %>
  </div>
</div>

<table class="table">
  <tbody>
    <% @registrant.attributes.except('password_digest').each do |k, v| %>
      <tr>
        <th><%= k.humanize %></th>
        <td><%= v %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="actions d-flex justify-content-center gap-2 my-3">
  <%= button_to 'Approve', approve_admin_registrant_path(@registrant), method: :patch, class: 'btn btn-success' %>
  <%= button_to 'Deny', deny_admin_registrant_path(@registrant), method: :patch, class: 'btn btn-danger' %>
</div>
