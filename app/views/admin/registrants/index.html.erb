<h1>Registrants (Pending)</h1>

<table class="table users-list">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @registrants.each do |u| %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.email %></td>
        <td><%= u.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>
