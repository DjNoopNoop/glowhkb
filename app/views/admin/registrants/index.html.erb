<h1>Pending Registrants</h1>

<table id="admin-registrants-table" class="display" style="width:100%">
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Created</th>
      <th>Actions</th>
    </tr>
  </thead>
</table>

<script>
  (function() {
    function initRegistrantsTable() {
      if (!(window.jQuery && $.fn.dataTable)) return;
      var $table = $('#admin-registrants-table');
      var $wrapper = $table.closest('.dataTables_wrapper');
      if ($wrapper.length && !$.fn.dataTable.isDataTable($table)) {
        $wrapper.replaceWith($table);
      }
      if ($.fn.dataTable.isDataTable($table)) {
        $table.DataTable().ajax.reload();
        return;
      }

      $table.DataTable({
        ajax: {
          url: '<%= admin_registrants_path(format: :json) %>',
          dataSrc: ''
        },
        columns: [
          { data: 'username', render: function(data){ return data || '—'; } },
          { data: 'email' },
          { data: 'role', render: function(data){ return data || '—'; } },
          { data: 'created_at', render: function(data){ return data ? new Date(data).toLocaleString() : '—'; } },
          { data: null, orderable: false, searchable: false, render: function(data,type,row){
              var id = row.id;
              var show = '<a href="' + '/admin/registrants/' + id + '" class="btn btn-sm btn-outline-secondary me-1">Show</a>';
              return show;
            } }
        ],
        pageLength: 50,
        lengthMenu: [[50,100,200,400],[50,100,200,400]],
        searching: true,
        ordering: true,
        processing: true,
        deferRender: true
      });
    }

    document.addEventListener('turbo:load', function() {
      var $table = $('#admin-registrants-table');
      if (window.jQuery && $.fn.dataTable && $.fn.dataTable.isDataTable($table)) {
        $table.DataTable().ajax.reload();
        return;
      }
      if ($table.length) {
        initRegistrantsTable();
      }
    });
  })();
</script>
