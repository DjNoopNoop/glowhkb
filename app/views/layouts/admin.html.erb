<!DOCTYPE html>
<html>
  <head>
    <title>GLOWH-kb - Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.css", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Tom Select UMD (exposes window.TomSelect) -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
    <%= javascript_include_tag "https://code.jquery.com/jquery-3.7.1.min.js", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js", "data-turbo-track": "reload" %>
  </head>

  <body class="site">
    <%= render "layouts/header" %>
    <%= render "layouts/flash" %>
    <main class="site-main admin-site">
      <%= render "admin/sidebar" %>
      <div class="admin-content">
        <%= yield %>
      </div>
    </main>

    <!-- footer removed for admin pages -->
  </body>
</html>
