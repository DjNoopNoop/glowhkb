<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <%= link_to "GLOWH-kb", root_path, class: "site-logo" %>
      <div class="display-buttons">
        <%= link_to global_map_path, class: "nav-link display-button" do %>
          <i class="fa-solid fa-map-location-dot"></i>
          <span class="display-text">Map</span>
        <% end %>

        <%= link_to publications_path, class: "nav-link display-button" do %>
          <i class="fa-solid fa-table"></i>
          <span class="display-text">Tables</span>
        <% end %>
      </div>
    </div>

    <div class="header-center">
      <div class="search-placeholder" role="search" aria-label="Site search">
        Search functionality coming soon
      </div>
    </div>

    <div class="header-right">
      <nav class="site-nav" aria-label="Primary navigation">
        <!-- Global dropdown removed as requested -->
        <div class="auth-links">
          <%= link_to about_path, class: "nav-link about-link menu-button about-button" do %>
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span class="about-text">About</span>
          <% end %>

          <%= link_to updates_path, class: "nav-link updates-link menu-button updates-button" do %>
            <i class="fa-regular fa-newspaper" aria-hidden="true"></i>
            <span class="updates-text">Updates</span>
          <% end %>

          <% if logged_in? %>
            <div data-controller="user-menu" class="manage-menu nav-dropdown">
              <button
                data-action="click->user-menu#toggle"
                class="nav-link nav-dropdown-toggle manage-button menu-button"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
              >
                <i class="fa-solid fa-user-gear" aria-hidden="true"></i>
                Manage
                <span class="nav-caret" aria-hidden="true">▾</span>
              </button>

              <div class="nav-dropdown-menu manage-menu-dropdown" data-user-menu-target="menu" role="menu" aria-hidden="true">
                <% if current_user&.is_admin? %>
                  <%= link_to "Admin", admin_users_path, class: "nav-dropdown-item admin-link", role: "menuitem" %>
                <% end %>
                  <%= link_to "Your submissions", submissions_path, class: "nav-dropdown-item", role: "menuitem" %>
              </div>
            </div>

            <div data-controller="user-menu" class="user-menu">
              <button
                data-action="click->user-menu#toggle"
                aria-haspopup="true"
                aria-expanded="false"
                class="user-button menu-button nav-link"
                type="button"
              >
                <%= image_tag "avatar-placeholder.svg", alt: "", class: "avatar" %>
                <span class="username"><%= current_user.name.presence || current_user.email %></span>
                <span class="nav-caret" aria-hidden="true">▾</span>
              </button>

              <div class="user-menu-dropdown" data-user-menu-target="menu" role="menu" aria-hidden="true">
                <%= link_to "Account settings", account_path, class: "nav-dropdown-item", role: "menuitem" %>
                <%= button_to "Sign out", logout_path, method: :delete, form: { class: "inline-form" }, class: "nav-dropdown-item", role: "menuitem" %>
              </div>
            </div>
          <% else %>
            <%= link_to "Sign up", signup_path, class: "nav-link signup-button" %>
            <%= link_to "Sign in", login_path, class: "nav-link" %>
          <% end %>
        </div>
      </nav>
    </div>
  </div>
</header>
<% if !controller_path.start_with?("admin/") && ((controller_name == 'global' && action_name == 'map') || (controller_name == 'publications' && action_name == 'index')) %>
  <%= render 'layouts/filter' %>
<% end %>
