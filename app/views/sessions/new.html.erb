<h1>Sign in</h1>

<%= form_with url: login_path, method: :post, local: true do %>
  <div>
    <%= label_tag :email %><br>
    <%= email_field_tag :email, params[:email] %>
  </div>

  <div>
    <%= label_tag :password %><br>
    <%= password_field_tag :password %>
  </div>

  <div>
    <%= submit_tag "Sign in" %>
  </div>
<% end %>
