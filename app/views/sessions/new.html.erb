<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Sign in</h1>

      <%= form_with url: login_path, method: :post, local: true do %>
        <div class="mb-3">
            <%= label_tag :email, 'Email or username', class: 'form-label' %>
            <%= text_field_tag :email, params[:email], class: 'form-control', placeholder: 'Email or username' %>
        </div>

        <div class="mb-3">
          <%= label_tag :password, 'Password', class: 'form-label' %>
          <%= password_field_tag :password, nil, class: 'form-control' %>
        </div>

        <div class="d-flex justify-content-center mt-4">
          <%= submit_tag "Sign in", class: 'btn btn-primary btn-lg' %>
        </div>
        <div class="text-center mt-3">
          <%= link_to 'Forgot your password?', new_password_reset_path, class: 'small' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
