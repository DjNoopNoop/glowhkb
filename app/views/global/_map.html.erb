<div id="mapbox-map"
    class="mapbox-map"
    data-controller="map"
    data-map-mapbox-token="<%= ENV['MAPBOX_ACCESS_TOKEN'] || Rails.application.credentials.dig(:mapbox, :access_token) %>">

    <script type="application/json" data-map-publications>
        <%= raw @publications.to_json(only: [:id, :title, :authors, :year, :journal, :url, :latitude, :longitude]) %>
    </script>
</div>
