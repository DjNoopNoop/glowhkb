<% form_url = @user.new_record? ? signup_path : account_path %>
<%= form_with model: @user, url: form_url, local: true do |f| %>
  <div class="card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <%= f.label :username, class: 'form-label fw-bold' %>
          <% username_class = 'form-control' + (f.object.errors[:username].any? ? ' is-invalid' : '') %>
          <%= f.text_field :username, class: username_class %>
          <% if f.object.errors[:username].any? %>
            <div class="invalid-feedback"><%= f.object.errors[:username].first %></div>
          <% end %>
        </div>

        <div class="col-md-6">
          <%= f.label :email, class: 'form-label fw-bold' %>
          <% email_class = 'form-control' + (f.object.errors[:email].any? ? ' is-invalid' : '') %>
          <%= f.email_field :email, class: email_class %>
          <% if f.object.errors[:email].any? %>
            <div class="invalid-feedback"><%= f.object.errors[:email].first %></div>
          <% end %>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col-md-6">
          <%= f.label :password, class: 'form-label fw-bold' %>
          <% pw_class = 'form-control' + (f.object.errors[:password].any? ? ' is-invalid' : '') %>
          <%= f.password_field :password, class: pw_class, autocomplete: 'new-password' %>
          <% if f.object.errors[:password].any? %>
            <div class="invalid-feedback"><%= f.object.errors[:password].first %></div>
          <% end %>
        </div>

        <div class="col-md-6">
          <%= f.label :password_confirmation, class: 'form-label fw-bold' %>
          <% pwc_class = 'form-control' + (f.object.errors[:password_confirmation].any? ? ' is-invalid' : '') %>
          <%= f.password_field :password_confirmation, class: pwc_class, autocomplete: 'new-password' %>
          <% if f.object.errors[:password_confirmation].any? %>
            <div class="invalid-feedback"><%= f.object.errors[:password_confirmation].first %></div>
          <% end %>
        </div>
      </div>

      <% if @user.new_record? %>
        <div class="mt-3">
          <label class="form-label fw-bold">Role</label>
          <div class="mb-2 small text-muted">Contributors may submit publications for consideration.</div>
          <div class="mb-2 small text-muted">Adjudicators review submissions and may approve items for public display.</div>
          <div class="d-flex gap-3">
            <% User.public_roles.each do |r| %>
              <div class="form-check">
                <%= f.radio_button :role, r, id: "user_role_#{r}", class: 'form-check-input' %>
                <%= label_tag "user_role_#{r}", r.humanize, class: 'form-check-label' %>
              </div>
            <% end %>
          </div>
          <% if f.object.errors[:role].any? %>
            <div class="invalid-feedback d-block"><%= f.object.errors[:role].first %></div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="card-footer bg-transparent border-0">
      <div class="d-flex justify-content-center">
        <%= f.submit @user.new_record? ? 'Create User' : 'Update Account', class: 'btn btn-primary btn-lg' %>
      </div>
    </div>
  </div>
<% end %>
