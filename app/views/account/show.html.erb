<h1>Account</h1>

<div class="user-details">
  <p><strong>Name:</strong> <%= @user.name.presence || "(not set)" %></p>
  <p><strong>Email:</strong> <%= @user.email %></p>
  <p><strong>Role:</strong> <%= @user.role.present? ? @user.role.humanize : "(not set)" %></p>
  <p><strong>Status:</strong> <%= @user.status.present? ? @user.status.humanize : "(not set)" %></p>
</div>

<% if current_user == @user %>
  <%= link_to "Edit account", edit_account_path, class: "button" %>
<% end %>
