<div class="container py-4">
	<div class="row justify-content-center">
		<div class="col-md-8">
			<h1 class="h4 mb-3">Edit profile</h1>

			<% if @user.errors.any? %>
				<div class="alert alert-danger">
					<strong>There was a problem with your submission:</strong>
					<ul class="mb-0 mt-2">
						<% @user.errors.full_messages.each do |msg| %>
							<li><%= msg %></li>
						<% end %>
					</ul>
				</div>
			<% end %>

			<%= form_with model: @user, url: account_path, method: :patch, local: true do |f| %>
				<div class="card mb-3">
					<div class="card-body">
						<div class="mb-3">
							<%= f.label :name, class: 'form-label fw-bold' %>
							<% name_class = 'form-control' + (f.object.errors[:name].any? ? ' is-invalid' : '') %>
							<%= f.text_field :name, class: name_class %>
							<% if f.object.errors[:name].any? %>
								<div class="invalid-feedback d-block"><%= f.object.errors[:name].first %></div>
							<% end %>
						</div>

						<div class="mb-3">
							<%= f.label :email, class: 'form-label fw-bold' %>
							<% email_class = 'form-control' + (f.object.errors[:email].any? ? ' is-invalid' : '') %>
							<%= f.email_field :email, class: email_class %>
							<% if f.object.errors[:email].any? %>
								<div class="invalid-feedback d-block"><%= f.object.errors[:email].first %></div>
							<% end %>
						</div>
					</div>
					<div class="card-footer bg-transparent border-0">
						<div class="d-flex justify-content-center">
							<%= f.submit 'Update Account', class: 'btn btn-primary' %>
						</div>
					</div>
				</div>
			<% end %>

			<h2 class="h5 mt-4 mb-3">Change password</h2>
			<%= form_with model: @user, url: update_account_password_path, method: :patch, local: true do |f| %>
				<div class="card">
					<div class="card-body">
						<div class="mb-3">
							<%= f.label :password, class: 'form-label fw-bold' %>
							<% pw_class = 'form-control' + (f.object.errors[:password].any? ? ' is-invalid' : '') %>
							<%= f.password_field :password, class: pw_class, autocomplete: 'new-password' %>
							<% if f.object.errors[:password].any? %>
								<div class="invalid-feedback d-block"><%= f.object.errors[:password].first %></div>
							<% end %>
						</div>

						<div class="mb-3">
							<%= f.label :password_confirmation, class: 'form-label fw-bold' %>
							<% pwc_class = 'form-control' + (f.object.errors[:password_confirmation].any? ? ' is-invalid' : '') %>
							<%= f.password_field :password_confirmation, class: pwc_class, autocomplete: 'new-password' %>
							<% if f.object.errors[:password_confirmation].any? %>
								<div class="invalid-feedback d-block"><%= f.object.errors[:password_confirmation].first %></div>
							<% end %>
						</div>
					</div>
					<div class="card-footer bg-transparent border-0">
						<div class="d-flex justify-content-center">
							<%= f.submit 'Change Password', class: 'btn btn-outline-primary' %>
						</div>
					</div>
				</div>
			<% end %>
		</div>
	</div>
</div>
