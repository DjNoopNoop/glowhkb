<div class="container mb-3">
  <div class="d-flex justify-content-between align-items-start flex-wrap mt-3">
    <div class="me-3">
      <div class="d-flex align-items-center mb-2">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0 d-flex">
            <li class="breadcrumb-item">Manage</li>
            <li class="breadcrumb-item active" aria-current="page">Your submissions</li>
          </ol>
        </nav>
      </div>
      <div class="mt-2">
        <h1 class="h3 mb-0">Your submissions</h1>
      </div>
    </div>

    <div class="ms-auto">
      <%= link_to new_submission_path, class: "btn btn-primary" do %>
        <i class="fa-solid fa-plus"></i>
        <span class="ms-1">New submission</span>
      <% end %>
    </div>
  </div>
</div>

<div class="container">
  <div class="row mt-3">
    <div class="col-12">
      <table id="user-submissions-table" class="display" style="width:100%">
        <thead>
          <tr>
            <th>Title</th>
            <th>Authors</th>
            <th>Journal</th>
            <th>Year</th>
            <th>DOI</th>
            <th>URL</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (function() {
    function initSubmissionsTable() {
      if (!(window.jQuery && $.fn.dataTable)) return;
      var $table = $('#user-submissions-table');
      var $wrapper = $table.closest('.dataTables_wrapper');
      if ($wrapper.length && !$.fn.dataTable.isDataTable($table)) {
        $wrapper.replaceWith($table);
      }
      if ($.fn.dataTable.isDataTable($table)) {
        $table.DataTable().ajax.reload();
        return;
      }

      $table.DataTable({
        serverSide: true,
        ajax: {
          url: '<%= submissions_path(format: :json) %>',
          dataSrc: 'data'
        },
        columns: [
          { data: 'title', render: function(data){ return data || '—'; } },
          { data: 'authors', render: function(data){ return data ? data : '—'; } },
          { data: 'journal', render: function(data){ return data || '—'; } },
          { data: 'year' },
          { data: 'doi', render: function(data){ if(!data) return '—'; return '<a href="https://doi.org/'+data+'" target="_blank" rel="noopener">'+data+'</a>'; } },
          { data: 'url', render: function(data){ if(!data) return '—'; var href = data.match(/^https?:\/\//) ? data : 'http://' + data; return '<a href="'+href+'" target="_blank" rel="noopener">Link</a>'; } },
          { data: 'status', render: function(data){ return data || '—'; } },
          { data: 'created_at', render: function(data){ return data ? new Date(data).toLocaleString() : '—'; } },
          { data: 'updated_at', render: function(data){ return data ? new Date(data).toLocaleString() : '—'; } },
          { data: 'actions_html', orderable: false, searchable: false, defaultContent: '' }
        ],
        columnDefs: [
          { targets: -1, createdCell: function(td, cellData){ td.innerHTML = cellData || ''; } }
        ],
        pageLength: 25,
        lengthMenu: [[25,50,100],[25,50,100]],
        searching: true,
        ordering: true,
        processing: true,
        deferRender: true
      });
    }

    window.deleteSubmission = function(id) {
      if (!confirm('Are you sure you want to delete this submission?')) return;
      var token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      fetch('/submissions/' + id, {
        method: 'DELETE',
        headers: {
          'X-CSRF-Token': token,
          'Accept': 'application/json'
        }
      }).then(function(resp){
        if (resp.ok) {
          var $table = $('#user-submissions-table');
          if ($.fn.dataTable.isDataTable($table)) $table.DataTable().ajax.reload();
        } else {
          resp.text().then(function(t){ alert('Delete failed: ' + t); });
        }
      }).catch(function(e){ alert('Delete failed'); });
    }

    document.addEventListener('turbo:load', function() {
      initSubmissionsTable();
    });
  })();
</script>
