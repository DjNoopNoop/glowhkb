          <p class="lead mb-4"><%= local_assigns[:message] || 'This page is still in development. Check back soon for updates.' %></p>
          <%= link_to 'Return Home', root_path, class: 'btn btn-outline-primary' %>
        </div>
      </div>
    </div>
  </div>
</section>
