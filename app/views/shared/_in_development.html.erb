      <div class="card border-info">
        <div class="card-body text-center">
          <h1 class="display-6 mb-3 text-primary">
            <i class="fa-solid fa-hard-hat me-2" aria-hidden="true"></i>
            <%= local_assigns[:title] || 'Coming Soon' %>
