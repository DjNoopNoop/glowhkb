<%= form_with model: @publication, local: true do |f| %>

  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :doi %><br>
    <%= f.text_field :doi %>
  </div>

  <div>
    <%= f.label :url %><br>
    <%= f.url_field :url %>
  </div>

  <div>
    <%= f.label :geographic_location_id, "Geographic Location" %><br>
    <%= f.collection_select :geographic_location_id,
          GeographicLocation.order(:name),
          :id,
          :name,
          { include_blank: true },
          { data: { controller: "tom-select" } } %>
  </div>

  <div>
    <%= f.label :authors %><br>
    <%= f.text_area :authors %>
  </div>

  <div>
    <%= f.label :journal %><br>
    <%= f.text_field :journal %>
  </div>

  <div>
    <%= f.label :year %><br>
    <%= f.number_field :year %>
  </div>

  <div>
    <%= f.label :air_pollutant_ids, "Air Pollutants" %><br>
    <%= f.collection_select :air_pollutant_ids,
          AirPollutant.order(:name),
          :id,
          :name,
          {},
          {
            multiple: true,
            data: { controller: "tom-select" }
          } %>
  </div>

  <div>
    <%= f.label :weather_parameter_ids, "Weather Parameters" %><br>
    <%= f.collection_select :weather_parameter_ids,
          WeatherParameter.order(:name),
          :id,
          :name,
          {},
          {
            multiple: true,
            data: { controller: "tom-select" }
          } %>
  </div>

  <div>
    <%= f.label :medical_condition_ids, "Medical Conditions" %><br>
    <%= f.collection_select :medical_condition_ids,
          MedicalCondition.order(:name),
          :id,
          :name,
          {},
          {
            multiple: true,
            data: { controller: "tom-select" }
          } %>
  </div>

  <div>
    <%= f.label :statistical_method_ids, "Statistical Methods" %><br>
    <%= f.collection_select :statistical_method_ids,
          StatisticalMethod.order(:name),
          :id,
          :name,
          {},
          {
            multiple: true,
            data: { controller: "tom-select" }
          } %>
  </div>

  <div class="form-actions">
    <%= link_to "Back", publications_path, class: "button secondary" %>
    <%= f.submit class: "button primary" %>
  </div>
<% end %>
