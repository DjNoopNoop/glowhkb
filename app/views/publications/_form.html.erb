<%= form_with model: @publication, local: true do |f| %>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :url %><br>
    <%= f.url_field :url %>
  </div>

  <div>
    <%= f.label :authors %><br>
    <%= f.text_area :authors %>
  </div>

  <div>
    <%= f.label :journal %><br>
    <%= f.text_field :journal %>
  </div>

  <div>
    <%= f.label :year %><br>
    <%= f.number_field :year %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
