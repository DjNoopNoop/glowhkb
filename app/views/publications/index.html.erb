<h1>Publications</h1>

<%# Public index: no admin action buttons here. Admin manages publications in /admin %>

<ul>
  <% @publications.each do |p| %>
    <li>
      <%= link_to p.title, publication_path(p) %>
      <% if p.user %> — by <%= p.user.email %><% end %>
      <%# Admin controls removed from public index view %>
    </li>
  <% end %>
</ul>
