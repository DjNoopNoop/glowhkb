<div class="container my-4">
  <div class="row mb-3">
    <div class="col-12">
      <h1 class="mb-0">Publications</h1>
      <p class="text-muted small mt-1">Search, sort and filter publications below.</p>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div data-controller="datatable">
        <table class="table table-striped table-hover mb-4" cellspacing="0" width="100%" data-datatable-target="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Authors</th>
              <th>Journal</th>
              <th>Year</th>
              <th>Location</th>
              <th>Air pollutants</th>
              <th>Medical conditions</th>
              <th>Weather parameters</th>
              <th>Statistical methods</th>
            </tr>
          </thead>
          <tbody>
            <%# rows are loaded via AJAX %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
