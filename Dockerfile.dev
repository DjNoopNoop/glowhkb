# syntax=docker/dockerfile:1

ARG RUBY_VERSION=3.3.4
FROM ruby:${RUBY_VERSION}-slim

WORKDIR /rails

# Basic OS deps for Rails dev + common gems
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
  build-essential \
  git \
  curl \
  libpq-dev \
  postgresql-client \
  libvips \
  pkg-config \
  && rm -rf /var/lib/apt/lists/*

# Node is only needed if you use jsbundling-rails (esbuild/rollup/webpack)
# If you're using importmap, you can remove this block.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get update -qq && apt-get install -y --no-install-recommends nodejs \
  && npm install -g yarn \
  && rm -rf /var/lib/apt/lists/*

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

# Copy the app (in dev this will usually be overridden by a bind-mount)
COPY . .

EXPOSE 3000
CMD ["bash", "-lc", "bin/rails server -b 0.0.0.0 -p 3000"]
